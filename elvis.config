%% STOP. DO NOT ADD EXCEPTIONS TO THIS FILE.
%%
%% If Elvis is failing, your Erlang FFI contains logic that belongs in PureScript.
%%
%% Erlang FFI must ONLY contain:
%% - Calls to erlang:* primitives (spawn_monitor, exit, send, receive)
%% - Direct exports of those primitives
%% - One-liner wrappers that call a single primitive
%%
%% FORBIDDEN in FFI:
%% - if/case statements
%% - Pattern matching beyond simple destructuring
%% - String formatting or concatenation
%% - Data transformation
%% - Error construction
%% - try/catch with multiple clauses
%%
%% If you think you need an exception, you are wrong. Refactor the FFI instead.
%% Move ALL logic to PureScript using thin FFI helpers like:
%% - tupleSize, tupleElement (to inspect opaque terms)
%% - atomToString, stringToAtom (for atom handling)
%% - formatTerm (for debugging)
%%
%% See test-concurrent-erl/src/Control/Monad/Concurrent/Class.purs for the correct pattern.
%% That file does decode_exit_reason in PureScript, not Erlang.
%%
%% NAMING CONVENTIONS:
%% PureRL generates Erlang modules with:
%% - Module names like `module_path@foreign` or `module_path@ps`
%% - Function names using camelCase (matching PureScript conventions)
%% - Map keys using camelCase (matching PureScript record field names)
%% We configure custom patterns to allow these naming styles.

[
    {elvis, [
        {config, [
            %% Rule configuration for Erlang source files
            #{
                dirs => ["src/**", "test/**", "test-concurrent-erl/**"],
                filter => "*.erl",
                ruleset => erl_files,
                rules => [
                    %% === STRICT FFI RULES (thin stubs only) ===

                    %% FFI functions must be thin stubs - typically 1-5 lines
                    %% If you need more, the logic belongs in PureScript
                    {elvis_style, max_function_length, #{
                        max_length => 10
                    }},

                    %% No nested try/catch - FFI should not have complex exception handling
                    {elvis_style, no_nested_try_catch, #{}},

                    %% Max nesting level of 2 - FFI should be flat
                    %% fun() -> single_call() end is level 2
                    {elvis_style, nesting_level, #{
                        level => 2
                    }},

                    %% receive without timeout is allowed - it's a primitive
                    {elvis_style, no_receive_without_timeout, disable},

                    %% === NAMING CONVENTIONS (PureRL compatibility) ===

                    %% Module naming: allow PureRL naming convention (module@foreign, module@ps)
                    {elvis_style, module_naming_convention, #{
                        regex => "^[a-z][a-zA-Z0-9_]*@(foreign|ps)$"
                    }},

                    %% Function naming: allow camelCase (matching PureScript conventions)
                    {elvis_style, function_naming_convention, #{
                        regex => "^[a-z][a-zA-Z0-9_]*$"
                    }},

                    %% Atom naming: allow camelCase for map keys (matching PureScript records)
                    {elvis_style, atom_naming_convention, #{
                        regex => "^[a-z][a-zA-Z0-9_]*$"
                    }},

                    %% === ENABLED RULES (general code quality) ===

                    %% Operator spacing for readable code
                    {elvis_style, operator_spaces, #{
                        rules => [
                            {right, ","},
                            {right, "++"},
                            {left, "++"}
                        ]
                    }}
                ]
            }
        ]}
    ]}
].
